# =============================================================================
# Animal Health Radar - environment template
# =============================================================================
# Copy to `.env` and fill in only what you need.
#
# IMPORTANT: the default build (`AHR_DATA_MODE=sample`) is fully OFFLINE and
# needs none of these. Credentials only matter if you implement the `live`
# fetch paths of the adapters in src/ingestion/.
# =============================================================================

# ---- run mode ---------------------------------------------------------------
# sample = synthetic offline corpus (default, what ships with the repo)
# live   = attempt real API calls in the adapters (requires the keys below)
AHR_DATA_MODE=sample

# Override the repository root if you run scripts from elsewhere
# AHR_PROJECT_ROOT=/path/to/animal_health_radar

# Override the pipeline "today". Must be ISO-8601 (YYYY-MM-DD).
# Everything published after this date is invisible to the pipeline.
# AHR_DATA_CUTOFF=2025-12-29

# Logging level: DEBUG | INFO | WARNING | ERROR
AHR_LOG_LEVEL=INFO

# ---- official animal health data -------------------------------------------
# WOAH WAHIS - https://wahis.woah.org  (public downloads; no key in practice)
WAHIS_API_BASE=https://wahis.woah.org/api
WAHIS_API_KEY=

# FAO EMPRES-i - https://empres-i.apps.fao.org
EMPRESI_API_BASE=https://empres-i.apps.fao.org/api/v1
EMPRESI_API_KEY=

# ---- epidemic intelligence --------------------------------------------------
# EU BEACON (Big data Epidemic intelligence)
BEACON_API_BASE=
BEACON_API_KEY=

# PADI-web (CIRAD news-based animal disease intelligence)
PADIWEB_API_BASE=
PADIWEB_API_KEY=

# WHO EIOS - access is restricted; the adapter ships a clearly-labelled MOCK
EIOS_API_BASE=
EIOS_CLIENT_ID=
EIOS_CLIENT_SECRET=

# ProMED-mail / HealthMap (optional)
PROMED_API_BASE=
PROMED_API_KEY=
HEALTHMAP_API_BASE=
HEALTHMAP_API_KEY=

# GDELT 2.0 (no key required for the public DOC/GKG endpoints)
GDELT_API_BASE=https://api.gdeltproject.org/api/v2

# ---- environmental / exposure ----------------------------------------------
# Copernicus CDS (ERA5, ERA5-Land)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# WorldClim (static download, no key)
WORLDCLIM_BASE=https://geodata.ucdavis.edu/climate/worldclim/2_1

# Gridded Livestock of the World v4 (Harvard Dataverse, no key)
GLW4_BASE=https://dataverse.harvard.edu/api

# FAOSTAT (no key)
FAOSTAT_API_BASE=https://faostatservices.fao.org/api/v1
